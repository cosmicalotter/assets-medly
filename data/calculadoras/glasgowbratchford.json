{
  "titulo": "Glasgow-Blatchford (hemorragia digestiva alta)",
  "descripcion": "Estima antes de la endoscopia la necesidad de tratamiento hospitalario (transfusión, endoscopia terapéutica o cirugía) en la hemorragia digestiva alta, con urea, hemoglobina, PAS, FC, melena, síncope y comorbilidad, de 0 a 23 puntos. Derivada en 1748 pacientes, identifica a quién puede tratarse de forma ambulatoria.",
  "instrucciones": "Con los datos de la llegada. Urea en mmol/L; con BUN o urea en mg/dL, cambia la unidad. Hemoglobina según el sexo.",
  "limitaciones": "Predice peor la mortalidad que la necesidad de intervención. No sustituye la reanimación ni la valoración clínica del paciente inestable.",
  "referencias": [
    {
      "titulo": "Blatchford O, Murray WR, Blatchford M. A risk score to predict need for treatment for upper-gastrointestinal haemorrhage. Lancet 2000;356(9238):1318-21.",
      "url": "https://pubmed.ncbi.nlm.nih.gov/11073021/"
    },
    {
      "titulo": "Orpen-Palmer J, Stanley AJ. A review of risk scores within upper gastrointestinal bleeding. J Clin Med 2023;12(11):3678.",
      "url": "https://pubmed.ncbi.nlm.nih.gov/37297873/",
      "paginas": "Tabla 1",
      "texto": "Blood Urea (mmol/L) 6.5–7.9: 2; 8.0–9.9: 3; 10.0–24.9: 4; >25.0: 6. Haemoglobin (g/L) Male 120–130: 1; 100–119: 3; <100: 6. Female 100–120: 1; <100: 6"
    },
    {
      "titulo": "Gralnek IM, Stanley AJ, Morris AJ, et al. Endoscopic diagnosis and management of nonvariceal upper gastrointestinal hemorrhage (NVUGIH): ESGE Guideline – Update 2021. Endoscopy 2021;53(3):300-32.",
      "url": "https://pubmed.ncbi.nlm.nih.gov/33567467/",
      "paginas": "Recomendación 1",
      "texto": "Patients with GBS ≤ 1 are at very low risk of rebleeding, mortality within 30 days, or needing hospital-based intervention and can be safely managed as outpatients with outpatient endoscopy."
    },
    {
      "titulo": "Gralnek IM, Stanley AJ, Morris AJ, et al. Endoscopic diagnosis and management of nonvariceal upper gastrointestinal hemorrhage (NVUGIH): ESGE Guideline – Update 2021. Endoscopy 2021;53(3):300-32. Endoscopia.",
      "url": "https://pubmed.ncbi.nlm.nih.gov/33567467/",
      "paginas": "Recomendaciones 3-4",
      "texto": "following hemodynamic resuscitation, early (≤ 24 hours) upper gastrointestinal (GI) endoscopy should be performed."
    }
