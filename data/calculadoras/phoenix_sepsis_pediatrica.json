{
  "titulo": "Phoenix: sepsis y choque séptico pediátricos (2024)",
  "descripcion": "Criterios internacionales de 2024 para sepsis y choque séptico en menores de 18 años. Suma la disfunción respiratoria, cardiovascular, de la coagulación y neurológica; reemplazan los criterios de SIRS de 2005.",
  "instrucciones": "Sólo con infección sospechada. Marcar lo que se tenga: lo no medido no suma. El S/F (saturación/FiO2) se usa sólo con SpO2 ≤97 %.",
  "limitaciones": "No aplica en la hospitalización del nacimiento, a menos de 37 semanas de edad posconcepcional ni a los 18 años o más. Detecta disfunción orgánica: no es una escala de alerta temprana para el triaje.",
  "tipoCalculo": "formula",
  "formula": "0.5 * (1 + ((rs + (va + la + pm) + 0.5 * ((pq + nr + dd + fb) + 2 - abs((pq + nr + dd + fb) - 2)) + nu) - 1.5) / abs((rs + (va + la + pm) + 0.5 * ((pq + nr + dd + fb) + 2 - abs((pq + nr + dd + fb) - 2)) + nu) - 1.5)) * (1 + 0.5 * (1 + ((va + la + pm) - 0.5) / abs((va + la + pm) - 0.5)))",
  "mostrarPuntaje": false,
  "prefijoResultado": "Phoenix",
  "extras": [
    {
      "etiqueta": "Phoenix Sepsis Score",
      "formula": "(rs + (va + la + pm) + 0.5 * ((pq + nr + dd + fb) + 2 - abs((pq + nr + dd + fb) - 2)) + nu)",
      "sufijo": "puntos",
      "decimales": 0
    }
  ],
  "referencias": [
    {
      "titulo": "Schlapbach LJ, Watson RS, Sorce LR, et al. International Consensus Criteria for Pediatric Sepsis and Septic Shock. JAMA 2024;331(8):665-674 (manuscrito aceptado, repositorio de la Universidad de Liverpool).",
      "url": "https://livrepository.liverpool.ac.uk/3178319/1/Criteria%20manuscript-R2%20clean%20-FINAL.%20submitted.pdf",
      "paginas": "29",
      "texto": "Sepsis: Suspected infection and Phoenix Sepsis Score ≥2 points Septic shock: Sepsis with ≥1 cardiovascular point(s)"
    },
    {
      "titulo": "Schlapbach LJ, Watson RS, Sorce LR, et al. International Consensus Criteria for Pediatric Sepsis and Septic Shock. JAMA 2024;331(8):665-674 (manuscrito aceptado, repositorio de la Universidad de Liverpool).",
      "url": "https://livrepository.liverpool.ac.uk/3178319/1/Criteria%20manuscript-R2%20clean%20-FINAL.%20submitted.pdf",
      "paginas": "29",
      "texto": "Unmeasured variables contribute no points to the score. Ages are not adjusted for prematurity, and the criteria do not apply to birth hospitalizations"
    },
    {
      "titulo": "Schlapbach LJ, Watson RS, Sorce LR, et al. International Consensus Criteria for Pediatric Sepsis and Septic Shock. JAMA 2024;331(8):665-674 (manuscrito aceptado, repositorio de la Universidad de Liverpool).",
      "url": "https://livrepository.liverpool.ac.uk/3178319/1/Criteria%20manuscript-R2%20clean%20-FINAL.%20submitted.pdf",
      "paginas": "5",
      "texto": "Children with a Phoenix Sepsis Score ≥2 points had in-hospital mortality of 7.1% in higher resource settings"
    }
