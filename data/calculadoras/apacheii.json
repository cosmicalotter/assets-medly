{
  "titulo": "APACHE II (gravedad en UCI)",
  "descripcion": "Mide la gravedad de la enfermedad al ingreso en la UCI con doce variables fisiológicas, la edad y la salud crónica previa, de 0 a 71 puntos. Se validó en 5815 ingresos de 13 hospitales: la puntuación se correlaciona con la mortalidad hospitalaria y, junto al diagnóstico, estratifica el pronóstico.",
  "instrucciones": "Usa los valores de las primeras 24 h en UCI. Escribe cada valor o marca su tramo. Oxigenación: AaDO₂ si FiO₂ ≥ 0,5; PaO₂ si < 0,5. Creatinina: una fila u otra según haya IRA.",
  "limitaciones": "Estima la mortalidad de grupos: en un paciente concreto el pronóstico depende también del diagnóstico de ingreso.",
  "referencias": [
    {
      "titulo": "Knaus WA, Draper EA, Wagner DP, Zimmerman JE. APACHE II: a severity of disease classification system. Crit Care Med 1985;13(10):818-29.",
      "url": "https://pubmed.ncbi.nlm.nih.gov/3928249/",
      "texto": "An increasing score (range 0 to 71) was closely correlated with the subsequent risk of hospital death for 5815 intensive care admissions from 13 hospitals."
    },
    {
      "titulo": "Ahmed AS, Iqbal M, Sethi SM, et al. Comparison of critical illness score in patients admitted to intermediate care units of a tertiary care hospital. J Crit Care Med (Targu Mures) 2024;10(1):38-48.",
      "url": "https://pubmed.ncbi.nlm.nih.gov/39108804/",
      "paginas": "Tabla de APACHE II",
      "texto": "Serum Cr (Normal: 0.6–1.4 mg/dL) Score × 2 (if AKI) ≥ 3.5 = 4 points, 2–3.4 = 3 points, 1.5–1.9 / <0.6 = 2 points"
    },
    {
      "titulo": "Ahmed AS, Iqbal M, Sethi SM, et al. Comparison of critical illness score in patients admitted to intermediate care units of a tertiary care hospital. J Crit Care Med (Targu Mures) 2024;10(1):38-48. Mortalidad.",
      "url": "https://pubmed.ncbi.nlm.nih.gov/39108804/",
      "paginas": "Tabla de APACHE II",
      "texto": "Score 0–4: 4%; 5–9: 8%; 10–14: 15%; 15–19: 25%; 20–24: 40%; 25–29: 55%; 30–34: 75%; >34: 85%"
    }
  ],
