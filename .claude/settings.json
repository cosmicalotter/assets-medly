{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/norma.py --hook"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(galgo validar:*)",
      "Bash(galgo auditar:*)",
      "Bash(python3 tools/norma.py:*)"
    ],
    "deny": [
      "Bash(galgo publicar:*)",
      "Bash(galgo indice:*)"
    ]
  }
}
